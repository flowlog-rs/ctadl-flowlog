// As no_derivation.dl, in a program with components: no output is derived
// from a fact or an input, so the translator gives the rule that never fires
// at top level for the first output in its instance, with the instance's
// type arguments: o.i.A("", 0).  Souffle writes every output empty.
.comp Outer {
  .comp Inner<U> {
    .decl A(x: U, n: number)
    .output A
    .decl R(x: U)
    R(x) :- R(x).
  }
  .init i = Inner<symbol>
  .init j = Inner<unsigned>
}
.init o = Outer
.decl B(x: symbol)
.output B
B(x) :- o.i.R(x).
