// Souffle's ResolveAliases replaces a variable equated to a constant
// expression by that expression before it types the clause, so each copy is
// typed where it lands (souffle2flowlog.py, alias_constants): with u
// unsigned, `x = 5, u < x, x - 10 < 0` compares `u < 5` on unsigned but
// computes `5 - 10 < 0` on number.  FlowLog types x once.
.decl U(x: unsigned)
U(3). U(5).
.decl A(s: symbol)
.output A
A("x=5, u<x, y=x-10, y<0") :- U(u), x = 5, u < x, y = x - 10, y < 0.
A("x=(0-1), u<x, x/2=0") :- U(u), x = 0 - 1, u < x, x / 2 = 0.
A("u<x, x=5, x-10<0") :- U(u), u < x, x = 5, x - 10 < 0.
A("u+0<x, x=5, x-10<0") :- U(u), u + 0 < x, x = 5, x - 10 < 0.
A("x=5, u<x-10") :- U(u), x = 5, u < x - 10.
A("x=5, u<x, z=x-10, z/2<0") :- U(u), x = 5, u < x, z = x - 10, z / 2 < 0.
A("v=u, x=5, v<x, x-10<0") :- U(u), v = u, x = 5, v < x, x - 10 < 0.
A("x=3, u<=x, x-10<0") :- U(u), x = 3, u <= x, x - 10 < 0.

// The head's type, and a negation, type the copies there.
.decl H(x: unsigned)
.output H
H(x) :- x = 3, x - 10 < 0.
.decl G(x: number)
.output G
G(1) :- x = 4, !U(x), x - 10 < 0.

// A literal compared with an unsigned value, and converted to a string.
.decl M(s: symbol)
.output M
M(cat("u<x ", to_string(x))) :- U(u), x = 0 - 1, u < x.
M(cat("x<u ", to_string(x))) :- U(u), x = 0 - 1, x < u.
M(cat("x>u ", to_string(x))) :- U(u), x = 0 - 1, x > u.
M("no string, u<x") :- U(u), x = 0 - 1, u < x.
M("no string, x<u") :- U(u), x = 0 - 1, x < u.
