// `.plan` hints (Souffle takes them on recursive clauses only): the
// translation keeps the order of version 0 where each clause of the
// translated rule reads the source's positive atoms, which FlowLog then
// joins in that order (flowlog_plan).
// expect-fl: .plan (3, 1, 2)
// expect-fl: .plan (2, 1, 3)
// expect-fl: .plan (2, 1)
// expect-fl: .plan (4, 3, 2, 1)
// expect-fl: .plan (2, 3, 1)
// expect-fl: .plan (3, 2, 1)
.decl A(x: number, y: number)
A(1, 2). A(2, 3). A(3, 4). A(4, 5). A(5, 1). A(2, 6).
.decl B(x: number, y: number)
B(2, 3). B(3, 4). B(4, 5). B(6, 2). B(5, 6).
.decl C(x: number, y: number)
C(3, 1). C(4, 2). C(5, 6). C(2, 5).

.decl J(x: number, z: number)
.output J
J(x, y) :- A(x, y).
J(x, z) :- J(x, y), B(y, w), C(w, z).
.plan 0:(3, 1, 2)

// two versions, a delta on either T: version 0 is kept
.decl T(x: number, y: number)
.output T
T(x, y) :- A(x, y).
T(x, z) :- T(x, y), T(y, z), B(z, _).
.plan 0:(2, 1, 3), 1:(1, 3, 2)

// each clause of the disjunction reads D and B
.decl D(x: number, z: number)
.output D
D(x, y) :- A(x, y).
D(x, z) :- D(x, y), B(y, z), (x < 3; z > 4).
.plan 0:(2, 1)

// the negation over a computed value is split off; the plan stays with the
// atoms
.decl N(x: number, v: number)
.output N
N(x, y) :- A(x, y).
N(x, v) :- N(x, y), B(y, z), C(z, w), A(w, v), !A(v + 1, x).
.plan 0:(4, 3, 2, 1)

// Souffle applies the plan to the clause with I inlined: L, A, A
.decl I(x: number, z: number) inline
I(x, z) :- A(x, y), A(y, z).
.decl L(x: number, w: number)
.output L
L(x, y) :- B(x, y).
L(x, w) :- L(x, y), I(y, w).
.plan 0:(2, 3, 1)

.comp P {
  .decl R(x: number, z: number)
  .output R
  R(x, y) :- A(x, y).
  R(x, z) :- R(x, y), B(y, z), C(z, _).
  .plan 0:(3, 2, 1)
}
.init p = P
