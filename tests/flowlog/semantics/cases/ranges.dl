// range(lo, hi): lo, lo+1, .., hi-1 when lo < hi; lo, lo-1, .., hi+1 when
// lo > hi; nothing when lo = hi. The translator enumerates 0 <= i < 1024 from
// a table and other ranges by recursion.
.decl B(lo: number, hi: number)
B(0, 3). B(5, 2). B(3, 3). B(-3, 2). B(2, -2). B(1020, 1030). B(1030, 1020). B(-1, -1).
B(0, 0). B(-5, -2). B(-2, -5). B(1022, 1024). B(1024, 1022). B(2147483646, 2147483649).
B(5000000002, 5000000000). B(0, 1). B(1, 0).
.decl RgB(lo: number, hi: number, i: number)
.output RgB
RgB(lo, hi, i) :- B(lo, hi), i = range(lo, hi).

.decl Rg(name: symbol, i: number)
.output Rg
Rg("const up", i) :- i = range(0, 4).
Rg("const down", i) :- i = range(3, -1).
Rg("const empty", i) :- i = range(7, 7).
Rg("expr", i) :- B(lo, hi), lo = 0, hi > 0, i = range(lo + 1, hi * 2).
Rg("nested", i * 10 + j) :- i = range(0, 3), j = range(i, 3).
Rg("nested down", i * 10 + j) :- i = range(3, 0), j = range(i, 0).
Rg("filtered", i) :- i = range(0, 2000), i % 500 = 7.
Rg("big", i) :- i = range(1000000, 1000005).
Rg("in head", i + 100) :- B(0, hi), i = range(0, hi).

// A relation whose only rule enumerates an empty range stays empty.
.decl Empty(i: number)
.output Empty
Empty(i) :- i = range(7, 7).
Empty(i) :- i = range(-3, -3), i = range(0, 2).
