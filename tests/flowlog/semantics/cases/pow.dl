// `^` on number is Souffle's static_cast<int64_t>(std::pow(a, b)): truncated,
// and INT64_MIN where the result is infinite or out of the int64 range (the
// cast is undefined behaviour in C++; x86-64 gives INT64_MIN).
.decl P(a: number, b: number)
P(0, -1). P(3, 40). P(-3, 41). P(2, 63). P(-2, 63). P(2, 62). P(1, -1). P(-1, -1).
P(2, -1). P(-8, 1). P(0, 0). P(10, 18). P(10, 19). P(-2, 64).
.decl O(a: number, b: number, n: number)
.output O
O(a, b, a ^ b) :- P(a, b).
