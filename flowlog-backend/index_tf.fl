.decl Local(var: symbol, fn_k: symbol)
Local(orig, fn_k) :-
    (Assign(orig, _, _, _, fn_k, _); Assign(_, _, orig, _, fn_k, _); FormalParam(_, fn_k, orig); ActualParam(_, orig, _, _, fn_k); AssignFunction(orig, _, _, fn_k, _); IndirectCall(orig, _, _, fn_k); TaintSpec(_, orig, _, _, fn_k, _, _, _); TaintSpec(_, _, _, _, fn_k, _, orig, _)), !Global(orig, _).
CFunction_Arity(fn_k, arity), CisFunction(fn_k), CFunction_Name(fn_k, fn_k) :-
    Function(fn_k, arity).
CVar_InFunction(var, fn_k), CVar_Name(var, name) :-
    Local(name, fn_k), var = cat(fn_k, cat("/", name)).
CFunction_FormalParam(fn_k, n, v) :-
    FormalParam(n, fn_k, iv), (Global(iv, _), v = cat(fn_k, cat("/", "<globals>")), p = cat(".", iv); !Global(iv, _), v = cat(fn_k, cat("/", iv)), p = "").
CFunction_isFormalParamByRef(fn_k, -1) :-
    CFunction_FormalParam(fn_k, -1, _).
CReturnParameter(-1).
CInsn_InFunction(stmt, sid, fn_k), CInsn_Move(stmt, v1, p1, v2, p2) :-
    Assign(iv1, ip1, iv2, ip2, fn_k, sid), (Global(iv1, _), v1 = cat(fn_k, cat("/", "<globals>")), tp1 = cat(".", iv1); !Global(iv1, _), v1 = cat(fn_k, cat("/", iv1)), tp1 = ""), (Global(iv2, _), v2 = cat(fn_k, cat("/", "<globals>")), tp2 = cat(".", iv2); !Global(iv2, _), v2 = cat(fn_k, cat("/", iv2)), tp2 = ""), p1 = cat(tp1, ip1), p2 = cat(tp2, ip2), stmt = cat(fn_k, cat("/", cat("assign", cat("/", to_string(sid))))).
CInsn_InFunction(stmt, cid, fn_k), CCall_ActualParam(stmt, n, v, p) :-
    ActualParam(n, iv, ip, cid, fn_k), (Global(iv, _), v = cat(fn_k, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fn_k, cat("/", iv)), tp = ""), p = cat(tp, ip), (DirectCall(_, cid, fn_k), stmt = cat(fn_k, cat("/", cat("call", cat("/", to_string(cid))))); IndirectCall(_, _, cid, fn_k), stmt = cat(fn_k, cat("/", cat("indirect-call", cat("/", to_string(cid)))))).
CInsn_InFunction(stmt, cid, fn_from), CInsn_UnsuspiciousCall(stmt, fn_to) :-
    DirectCall(fn_to, cid, fn_from), stmt = cat(fn_from, cat("/", cat("call", cat("/", to_string(cid))))).
CInsn_Use(v, p) :-
    (TaintSpec(_, iv, ip, _, fn_k, _, _, _); TaintSpec(_, _, _, _, fn_k, _, iv, ip); AssignFunction(iv, ip, _, fn_k, _)), (Global(iv, _), v = cat(fn_k, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fn_k, cat("/", iv)), tp = ""), p = cat(tp, ip).
CCall_ActualParam(s, -2, v, p), CCall_VirtualBase(s, -2), CInsn_InFunction(s, cid, fn_from), CInsn_Use(v, p), IndirectCallStmt(s, v, p) :-
    IndirectCall(iv, ip, cid, fn_from), (Global(iv, _), v = cat(fn_from, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fn_from, cat("/", iv)), tp = ""), p = cat(tp, ip), s = cat(fn_from, cat("/", cat("indirect-call", cat("/", to_string(cid))))).
CisAccessPath(ap) :-
    CInsn_Move(_, _, ap, _, _);
    CInsn_Move(_, _, _, _, ap);
    ActualParam(_, _, ap, _, _);
    Assign(_, ap, _, _, _, _);
    Assign(_, _, _, ap, _, _);
    AssignFunction(_, ap, _, _, _);
    IndirectCall(_, ap, _, _);
    TaintSpec(_, _, ap, _, _, _, _, _);
    TaintSpec(_, _, _, _, _, _, _, ap).
CisAlloc(v, p, func), CInsn_InFunction(insn, sid, fid), AssignFunctionStmt(insn, v, p, func) :-
    AssignFunction(iv, ip, func, fid, sid), (Global(iv, _), v = cat(fid, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fid, cat("/", iv)), tp = ""), p = cat(tp, ip), insn = cat(fid, cat("/", cat("assign-function", cat("/", to_string(sid))))).
IndirectCallResolventFunction(stmt, funcref, funcref) :-
    IndirectCallResolvent(_, stmt, funcref).
CisNamespace(fn_k) :-
    Function(fn_k, _).
.decl GlobalParam(pos: int64, name: symbol)
CGlobalParameter(-3).
GlobalParam(-3, "<globals>") :-
    ReadsGlobal(_, _);
    WritesGlobal(_, _).
CVar_InFunction(var, fn_k), CVar_Name(var, "<globals>") :-
    Function(fn_k, _), var = cat(fn_k, cat("/", "<globals>")), GlobalParam(_, _).
CFunction_isFormalParamByRef(fn_k, n), CVar_InFunction(v, fn_k), CVar_Name(v, gparam), CFunction_FormalParam(fn_k, n, v) :-
    Function(fn_k, _), GlobalParam(n, gparam), v = cat(fn_k, cat("/", gparam)).
CCall_ActualParam(insn, n, v, p) :-
    (CInsn_UnsuspiciousCall(insn, _); IndirectCallStmt(insn, _, _)), GlobalParam(n, gparam), CInsn_InFunction(insn, _, fn_k), v = cat(fn_k, cat("/", gparam)), p = "".
.decl WritesGlobal(fn_k: symbol, global: symbol)
WritesGlobal(fn_k, iv) :-
    Assign(iv, _, _, _, fn_k, _), Global(iv, _).
.decl ReadsGlobal(fn_k: symbol, global: symbol)
ReadsGlobal(fn_k, iv) :-
    Assign(_, _, iv, _, fn_k, _), Global(iv, _).
