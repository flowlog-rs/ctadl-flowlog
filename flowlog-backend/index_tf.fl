      VirtualAlloc(v, p, _, _).
  VirtualAlloc(var, ap, obj, "") :-
      SummaryAlloc(f, n, summary_ap, obj, ""), CallEdge(insn, f, ""), CCall_ActualParam(insn, n, var, actual_ap), (summary_ap = ""; actual_ap = ""), (actual_ap = "", ap = summary_ap; summary_ap = "", ap = actual_ap).
  VirtualAlloc(var, ap, obj, "") :-
      SummaryAlloc(f, n, summary_ap, obj, ""), CallEdge(insn, f, ""), CCall_ActualParam(insn, n, var, actual_ap), ComputedAccessPathNonEmptySplit(ap, actual_ap, summary_ap).
  LocallyReachable_Root(v, p) :-
      VirtualAlloc(v, p, _, _).
  SummaryAlloc(f, n, p, obj, ctx0) :-
      VirtualAlloc(v_obj, p_obj, obj, ctx1), LocallyReachable(param, p, v_obj, p_obj, ctx2), CFunction_FormalParam(f, n, param), CFunction_isFormalParamByRef(f, n), (ctx1 = "", ctx0 = ctx2; 1 = CallStringUnder(ctx2, ctx1), ctx0 = ctx1), !DisableGlobalDataFlow().
  SummaryAlloc(f, n, p, obj, ctx0) :-
      VirtualAlloc(v_obj, p_obj, obj, ctx1), LocallyReachable(param, p, v_obj, p_obj, ctx2), CFunction_FormalParam(f, n, param), p != "", (ctx1 = "", ctx0 = ctx2; 1 = CallStringUnder(ctx2, ctx1), ctx0 = ctx1), !DisableGlobalDataFlow().
  SummaryAlloc(f, n, p, obj, ctx) :-
      VirtualAlloc(v_obj, p_obj, obj, ctx), param = v_obj, p = p_obj, CFunction_FormalParam(f, n, param), (p != ""; CFunction_isFormalParamByRef(f, n)), !DisableGlobalDataFlow().
  SummaryAlloc(func, n1, FH, obj, ctx) :-
      LocallyReachable(a, G, x, F, ""), LocallyReachable(a, GH, y, K, ""), x != y, G != GH, VirtualAlloc(y, K, obj, ctx), G = "", F = "", GH = H, FH = H, CFunction_FormalParam(func, n1, x).
  SummaryAlloc(func, n1, FH, obj, ctx) :-
      LocallyReachable(a, G, x, F, ""), LocallyReachable(a, GH, y, K, ""), x != y, G != GH, VirtualAlloc(y, K, obj, ctx), G != "", F = "", ComputedAccessPathNonEmptySplit(GH, G, H), FH = H, CFunction_FormalParam(func, n1, x).
  SummaryAlloc(func, n1, FH, obj, ctx) :-
      LocallyReachable(a, G, x, F, ""), LocallyReachable(a, GH, y, K, ""), x != y, G != GH, VirtualAlloc(y, K, obj, ctx), G = "", F != "", GH = H, FH != "", ComputedAccessPathNonEmptySplit(FH, F, H), CFunction_FormalParam(func, n1, x).
  SummaryAlloc(func, n1, FH, obj, ctx) :-
      LocallyReachable(a, G, x, F, ""), LocallyReachable(a, GH, y, K, ""), x != y, G != GH, VirtualAlloc(y, K, obj, ctx), G != "", GH != "", F != "", ComputedAccessPathNonEmptySplit(GH, G, H), ComputedAccessPathNonEmptySplit(FH, F, H), CFunction_FormalParam(func, n1, x).
}
