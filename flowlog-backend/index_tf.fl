      CFunction_ModelInfluenceTo(func, n1, p1, n2, p2), CisFunction(func), CFunction_FormalParam(func, n1, _), CFunction_FormalParam(func, n2, _), sp1 = cat(p1, ".*"), (n1 != n2; sp1 != p2), !DisableGlobalDataFlow().
