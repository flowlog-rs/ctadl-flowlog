.decl VirtualAssign_choice(v1: CVar, p1: CAccessPath, v2: CVar, p2: CAccessPath, ctx: symbol, ck: min<int64>)
VirtualAssign(choice_field(choice_claim5(0, 1, ck, v1, p1, v2, p2, ctx), 0), v1, p1, v2, p2, choice_field(choice_claim5(0, 1, ck, v1, p1, v2, p2, ctx), 1), ctx) :-
    VirtualAssign_choice(v1, p1, v2, p2, ctx, ck).
VirtualAssign_choice(v1, p1, v2, p2, ctx, choice_claim5(0, 1, ck, v1, p1, v2, p2, ctx)) :-
    VirtualAssign_choice(v1, p1, v2, p2, ctx, ck).
