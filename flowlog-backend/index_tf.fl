.decl CTADLStats_AnalyzedFunction(m: CFunction)
CTADLStats_AnalyzedFunction(m) :-
    CInsn_InFunction(_, _, m).
CTADLStats("CInsn_Move", n) :-
    n = count : { CInsn_Move(agg_w1, agg_w2, agg_w3, agg_w4, agg_w5) }.
CTADLStats("CInsn_Use", n) :-
    n = count : { CInsn_Use(agg_w6, agg_w7) }.
CTADLStats("CInsn_Call", n) :-
    n = count : { CallEdge(agg_w8, agg_w9, agg_w10) }.
CTADLStats("CisFunction", n) :-
    n = count : { CisFunction(agg_w11) }.
CTADLStats("CFunction_Name", n) :-
    n = count : { CFunction_Name(agg_w12, agg_w13) }.
CTADLStats("CFunction_Arity", n) :-
    n = count : { CFunction_Arity(agg_w14, agg_w15) }.
CTADLStats("CFunction_FormalParam", n) :-
    n = count : { CFunction_FormalParam(agg_w16, agg_w17, agg_w18) }.
CTADLStats("CFunction_isFormalParamByRef", n) :-
    n = count : { CFunction_isFormalParamByRef(agg_w19, agg_w20) }.
CTADLStats("CFunction_ModelAssign", n) :-
    n = count : { CFunction_ModelAssign(agg_w21, agg_w22, agg_w23, agg_w24, agg_w25, agg_w26) }.
CTADLStats("CCall_ActualParam", n) :-
    n = count : { CCall_ActualParam(agg_w27, agg_w28, agg_w29, agg_w30) }.
CTADLStats("CisAccessPath", n) :-
    n = count : { CisAccessPath(agg_w31) }.
CTADLStats("CInsn_InFunction", n) :-
    n = count : { CInsn_InFunction(agg_w32, agg_w33, agg_w34) }.
CTADLStats("CVar_InFunction", n) :-
    n = count : { CVar_InFunction(agg_w35, agg_w36) }.
CTADLStats("CVar_isGlobal", n) :-
    n = count : { CVar_isGlobal(agg_w37) }.
CTADLStats("CVar_Name", n) :-
    n = count : { CVar_Name(agg_w38, agg_w39) }.
CTADLStats("analyzed-function", n) :-
    n = count : { CTADLStats_AnalyzedFunction(agg_w40) }.
CTADLStats("CisAlloc", n) :-
    n = count : { CisAlloc(agg_w41, agg_w42, agg_w43) }.
CTADLStats("CCall_VirtualBase", n) :-
    n = count : { CCall_VirtualBase(agg_w44, agg_w45) }.
CTADLError(msg) :-
    CisFunction(f), !CFunction_Name(f, _), msg = cat("Function with no name: ", f).
CTADLError(msg) :-
    (CInsn_InFunction(_, _, f), ref = "CInsn_InFunction"; CFunction_Arity(f, _), ref = "CFunction_Arity"; CFunction_FormalParam(f, _, _), ref = "CFunction_FormalParam"; CFunction_isFormalParamByRef(f, _), ref = "CFunction_isFormalParamByRef"; CInsn_Call(_, f), ref = "CInsn_Call"; CVar_InFunction(_, f), ref = "CVar_InFunction"), !CisFunction(f), msg = cat("Reference from '", cat(ref, cat("' to non-existent function: ", f))).
CTADLError(msg) :-
    (CInsn_Move(i, _, _, _, _), kind = "move"; CCall_VirtualBase(i, _), kind = "virtual-base"; CCall_ActualParam(i, _, _, _), kind = "actual"; CInsn_Call(i, _), kind = "call"), !IntCInsn_InFunction(i, _, _), msg = cat("Instruction ", cat(kind, cat(" not inside function: ", i))).
CTADLError(msg) :-
    IntCInsn_InFunction(i, _, f1), IntCInsn_InFunction(i, _, f2), f1 != f2, msg = cat("Instruction in two functions, '", cat(f1, cat("' and '", cat(f2, cat("': ", i))))).
CTADLError(msg) :-
    (CInsn_Move(_, v, _, _, _), kind = "move"; CInsn_Move(_, _, _, v, _), kind = "move"; CisAlloc(v, _, _), kind = "alloc"; CInsn_Use(v, _), kind = "use"; CFunction_FormalParam(_, _, v), kind = "formal"; CCall_ActualParam(_, _, v, _), kind = "actual"), !CVar_InFunction(v, _), !CVar_isGlobal(v), msg = cat("Variable ", cat(kind, cat(" neither function or global: ", v))).
CTADLError(msg) :-
    CVar_InFunction(v, _), CVar_isGlobal(v), msg = cat("Variable is local and global: ", v).
CTADLError(msg) :-
    CVar_InFunction(v, _), !CVar_Name(v, _), msg = cat("Variable in function without name: ", v).
CTADLError(msg) :-
    CVar_InFunction(v, f1), CVar_InFunction(v, f2), f1 != f2, msg = cat("Variable in two functions, '", cat(f1, cat("' and '", cat(f2, cat("': ", v))))).
CTADLError(msg) :-
    (CNamespace_Parent(n, _); CNamespace_Parent(_, n)), !CisNamespace(n), msg = cat("Namespace not in CisNamespace: ", n).
