.init ctadl_taint_front_phase1 = CGraphRules
.comp SliceCallee_Input {
  .decl StartVertex(v: CVar, p: CAccessPath, label: SliceLabelType)
}
.comp SliceCallee {
  .init input_ = SliceCallee_Input
  .decl ReachableVertex(id: int64, v1: CVar, p1: CAccessPath, label: SliceLabelType)
  Vertex(v, p), ReachableVertex(souffle_ord(cat(v, cat(":", cat(p, cat(":", label))))), v, p, label) :-
      input_.StartVertex(v, p, label).
  ReachableVertex(vertex_to, v1, p1, tag) :-
      ReachableVertex(_, v2, p2, tag), VirtualAssign_choice(v1, p1, v2, p2, _, chck279), vertex_to = souffle_ord(cat(v1, cat(":", cat(p1, cat(":", tag))))).
  ReachableVertex(vertex_to, v_to, p_to, label) :-
      ReachableVertex(_, v_from, p_from, label), CallFlowEdge(_, v_to, p_to, v_from, p_from), vertex_to = souffle_ord(cat(v_to, cat(":", cat(p_to, cat(":", label))))).
  .decl CallFlowEdge(insn: CInsn, v_callee: CVar, p_callee: CAccessPath, v_caller: CVar, p_caller: CAccessPath)
  .decl IC(call: CInsn, n: int64, p: CAccessPath)
  IC(call, n, p2) :-
      ReachableVertex(_, v, p12, _label), CCall_ActualParam(call, n, v, p1), p1 != "", p2 != "", p12 != "", ComputedAccessPathNonEmptySplit(p12, p1, p2), CallEdge(call, _id, "");
      ReachableVertex(_, v, p12, _label), CCall_ActualParam(call, n, v, p1), p1 = "", p2 != "", p12 = p2, isComputedAccessPath(p12), CallEdge(call, _id, "");
      ReachableVertex(_, v, p12, _label), CCall_ActualParam(call, n, v, p1), p2 = "", p1 != "", p12 = p1, isComputedAccessPath(p12), CallEdge(call, _id, "");
      ReachableVertex(_, v, p12, _label), CCall_ActualParam(call, n, v, p1), p1 = "", p2 = "", p12 = "", isComputedAccessPath(""), CallEdge(call, _id, "").
  Vertex(v_callee, p2), CallFlowEdge(call, v_callee, p2, v_caller, cat(p1, p2)) :-
      IC(call, n, p2), CCall_ActualParam(call, n, v_caller, p1), CallEdge(call, id, ""), CFunction_FormalParam(id, n, v_callee).
}
.init track_assign_func = SliceCallee
track_assign_func.input_.StartVertex(v, p, func) :-
    VirtualAlloc(v, p, func, ""), EnableContextFreeObjectTracking().
CallEdge(s, fid, "") :-
    track_assign_func.ReachableVertex(_, v, p, fid), IndirectCallStmt(s, v, p), EnableContextFreeObjectTracking().
