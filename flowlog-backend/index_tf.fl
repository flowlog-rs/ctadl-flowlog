  CTADLError(msg) :-
      LocallyReachable(v1, _p1, v2, _p2, _), CVar_InFunction(v2, f2), CVar_InFunction(v1, f1), f1 != f2, msg = cat("LocallyReachable reaches across two functions, '", cat(f2, cat("' and '", cat(f1, cat("' with vars '", cat(v2, cat("' and '", cat(v1, "' respectively")))))))), !DisableInterproceduralLocalReachCheck().
  CTADLError(msg) :-
