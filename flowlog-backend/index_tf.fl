      LocallyReachable_Root(v2, p2), VirtualAssign_choice(v1, p1, v2, p2, ctx, chck59), !CVar_isGlobal(v1), !CVar_isGlobal(v2), CVar_InFunction(v1, m), CVar_InFunction(v2, m).
