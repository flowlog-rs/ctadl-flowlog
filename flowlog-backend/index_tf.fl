.decl FlowlogRangeDigit(d: int64)
.decl FlowlogRangeNat(n: int64)
.decl FlowlogRange(hi: int64, i: int64)
FlowlogRangeDigit(0).
FlowlogRangeDigit(1).
FlowlogRangeDigit(2).
FlowlogRangeDigit(3).
FlowlogRangeDigit(4).
FlowlogRangeDigit(5).
FlowlogRangeDigit(6).
FlowlogRangeDigit(7).
FlowlogRangeDigit(8).
FlowlogRangeDigit(9).
FlowlogRangeDigit(10).
FlowlogRangeDigit(11).
FlowlogRangeDigit(12).
FlowlogRangeDigit(13).
FlowlogRangeDigit(14).
FlowlogRangeDigit(15).
FlowlogRangeDigit(16).
FlowlogRangeDigit(17).
FlowlogRangeDigit(18).
FlowlogRangeDigit(19).
FlowlogRangeDigit(20).
FlowlogRangeDigit(21).
FlowlogRangeDigit(22).
FlowlogRangeDigit(23).
FlowlogRangeDigit(24).
FlowlogRangeDigit(25).
FlowlogRangeDigit(26).
FlowlogRangeDigit(27).
FlowlogRangeDigit(28).
FlowlogRangeDigit(29).
FlowlogRangeDigit(30).
FlowlogRangeDigit(31).
FlowlogRangeNat(a * 32 + b) :-
    FlowlogRangeDigit(a), FlowlogRangeDigit(b).
FlowlogRange(hi, i) :-
    FlowlogRangeNat(hi), FlowlogRangeNat(i), i < hi.
