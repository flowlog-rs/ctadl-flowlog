  .decl isContext(c: symbol)
  isContext(c) :-
      ContextObj(_, _, _, c).
  .decl isObjCtx(obj: symbol)
  isObjCtx(obj) :-
      ContextObj(_, _, obj, _).
  .decl isObjReachableVertex(var: CVar, path: CAccessPath)
  isObjReachableVertex(v, p) :-
      ContextObj(v, p, _, _).
  CTADLStats("ParthianVertex", n) :-
      n = count : { ParthianVertex(agg_w153, agg_w154, agg_w155) }.
  CTADLStats("ParthianFlowEdge", n) :-
      n = count : { ParthianFlowEdge(agg_w156, agg_w157, agg_w158, agg_w159, agg_w160, agg_w161, agg_w162) }.
  CTADLStats("ctx", n) :-
      n = count : { isContext(agg_w163) }.
  CTADLStats("obj-ctx", n) :-
      n = count : { isObjCtx(agg_w164) }.
  CTADLStats("obj-reachable-vertex", n) :-
      n = count : { isObjReachableVertex(agg_w165, agg_w166) }.
  CTADLStats("ContextObj", n) :-
