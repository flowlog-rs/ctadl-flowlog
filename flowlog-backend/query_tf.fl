FlowlogRangeNat(a * 32 + b) :-
    FlowlogRangeDigit(a), FlowlogRangeDigit(b).
FlowlogRange(hi, i) :-
    FlowlogRangeNat(hi), FlowlogRangeNat(i), i < hi.
