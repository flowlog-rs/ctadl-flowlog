.decl AccessPathNonEmptySplit(to_split: CAccessPath, prefix: CAccessPath, suffix: CAccessPath)
.decl DotIndex(ap: CAccessPath, index: int64)
DotIndex(ap, i) :-
    CisAccessPath(ap), souffle_strlen(ap) >= 3, souffle_strlen(ap) - 1 < 1024, lift_t2 = souffle_strlen(ap) - 1, FlowlogRange(lift_t2, i), i >= 2, souffle_substr(ap, i, 1) = ".";
    CisAccessPath(ap), souffle_strlen(ap) >= 3, lift_t3 = souffle_strlen(ap) - 1, Range1(2, lift_t3, i), souffle_substr(ap, i, 1) = ".".
Range1_req(2, souffle_strlen(ap) - 1) :-
    CisAccessPath(ap), souffle_strlen(ap) >= 3.
Range1(lo, hi, lo) :-
    Range1_req(lo, hi), lo < hi, hi >= 1024.
Range1(lo, hi, lo) :-
    Range1_req(lo, hi), hi < lo.
Range1(lo, hi, i + 1) :-
    Range1(lo, hi, i), i + 1 < hi.
Range1(lo, hi, i - 1) :-
    Range1(lo, hi, i), i - 1 > hi.
.decl Range1_req(lo: int64, hi: int64)
.decl Range1(lo: int64, hi: int64, i: int64)
AccessPathNonEmptySplit(ap, prefix, suffix) :-
    DotIndex(ap, i), prefix = souffle_substr(ap, 0, i), suffix = souffle_substr(ap, i, souffle_strlen(ap) - i + 1), CisAccessPath(prefix), !contains(".*", suffix).
.decl ComputedAccessPathNonEmptySplit(to_split: CAccessPath, prefix: CAccessPath, suffix: CAccessPath)
.decl ComputedDotIndex(ap: CAccessPath, index: int64)
ComputedDotIndex(ap, i) :-
    isComputedAccessPath(ap), souffle_strlen(ap) >= 3, souffle_strlen(ap) - 1 < 1024, lift_t4 = souffle_strlen(ap) - 1, FlowlogRange(lift_t4, i), i >= 2, souffle_substr(ap, i, 1) = ".";
    isComputedAccessPath(ap), souffle_strlen(ap) >= 3, lift_t5 = souffle_strlen(ap) - 1, Range2(2, lift_t5, i), souffle_substr(ap, i, 1) = ".".
Range2_req(2, souffle_strlen(ap) - 1) :-
    isComputedAccessPath(ap), souffle_strlen(ap) >= 3.
Range2(lo, hi, lo) :-
    Range2_req(lo, hi), lo < hi, hi >= 1024.
Range2(lo, hi, lo) :-
    Range2_req(lo, hi), hi < lo.
Range2(lo, hi, i + 1) :-
    Range2(lo, hi, i), i + 1 < hi.
Range2(lo, hi, i - 1) :-
    Range2(lo, hi, i), i - 1 > hi.
.decl Range2_req(lo: int64, hi: int64)
.decl Range2(lo: int64, hi: int64, i: int64)
ComputedAccessPathNonEmptySplit(ap, prefix, suffix) :-
    ComputedDotIndex(ap, i), prefix = souffle_substr(ap, 0, i), suffix = souffle_substr(ap, i, souffle_strlen(ap) - i + 1), isComputedAccessPath(prefix), !contains(".*", suffix).
.decl ComputedFieldNonEmptySplit(ap: CAccessPath, prefix: CAccessPath, field: CAccessPath)
ComputedFieldNonEmptySplit(ap, prefix, field) :-
    ComputedAccessPathNonEmptySplit(ap, prefix, field), CisField(field).
.decl FieldNonEmptySplit(ap: CAccessPath, prefix: CAccessPath, field: CAccessPath)
FieldNonEmptySplit(ap, prefix, field) :-
    AccessPathNonEmptySplit(ap, prefix, field), CisField(field).
CTADLStats("AccessPathNonEmptySplit", n) :-
    n = count : { AccessPathNonEmptySplit(agg_w6, agg_w7, agg_w8) }.
CTADLStats("ComputedAccessPathNonEmptySplit", n) :-
    n = count : { ComputedAccessPathNonEmptySplit(agg_w9, agg_w10, agg_w11) }.
