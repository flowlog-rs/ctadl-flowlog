.decl LostAssign(insn: CInsn, p13: CAccessPath, dir: symbol)
.decl LostAssign_choice(insn: CInsn, ck: min<int64>)
LostAssign(insn, choice_field(ck, 0), choice_field(ck, 1)) :-
    LostAssign_choice(insn, ck).
.output LostAssign(IO="sqlite", filename="ctadlir.db")
.decl NegPre22(c0: CInsn, c1: symbol, c2: CVar, c3: SliceLabelType)
NegPre22(insn, p13, v1, label) :-
    forward_flow.isReachable(v2, p23, label), VirtualAssign(insn, v1, p1, v2, p2, _reason, ""), p2 != "", p3 != "", p23 != "", ComputedAccessPathNonEmptySplit(p23, p2, p3), !contains(".*", p1), p13 = cat(p1, p3).
LostAssign_choice(insn, choice_key2(0, p13, "dest")) :-
    NegPre22(insn, p13, v1, label), !forward_flow.isReachable(v1, p13, label).
.decl NegPre23(c0: CInsn, c1: symbol, c2: CVar, c3: SliceLabelType)
NegPre23(insn, p13, v1, label) :-
