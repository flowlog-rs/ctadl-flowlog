.decl EnableForwardSlice()
.decl EnableBackwardSlice()
.decl TaintSourceOnlyVertex(v: CVar, p: CAccessPath)
TaintSourceOnlyVertex(v, p) :-
    TaintSourceVertexNonRec(_, v, p).
.decl LeakingSinkOnlyVertex(v: CVar, p: CAccessPath)
LeakingSinkOnlyVertex(v, p) :-
    LeakingSinkVertexNonRec(_, v, p).
.decl EndpointCounts(n_source: int64, n_sink: int64)
EndpointCounts(n_source, n_sink) :-
    n_source = count : { TaintSourceOnlyVertex(agg_w30, agg_w31) }, n_sink = count : { LeakingSinkOnlyVertex(agg_w32, agg_w33) }.
EnableForwardSlice() :-
    MG_SliceDirection("forward");
    !MG_SliceDirection(_), EndpointCounts(n_source, n_sink), (n_sink = 0; n_source > 0, n_source <= n_sink).
EnableBackwardSlice() :-
    MG_SliceDirection("backward");
    !MG_SliceDirection(_), EndpointCounts(n_source, n_sink), n_sink != 0, (n_source <= 0; n_source > n_sink).
forward_flow.input_.SliceForward() :-
    EnableForwardSlice().
forward_flow.input_.StartVertex(v, p, label) :-
    TaintSourceVertex(label, v, p), EnableForwardSlice().
forward_flow.Vertex(v, p) :-
    Vertex(v, p), EnableForwardSlice().
forward_flow.VirtualAssign(s, v1, p1, v2, p2, r, ctx) :-
    VirtualAssign(s, v1, p1, v2, p2, r, ctx), EnableForwardSlice().
forward_flow.input_.SanitizeAssign(v1, p1, v2, p2, l) :-
    TaintSanitizeEdge(l, v1, p1, v2, p2), EnableForwardSlice().
forward_flow.input_.SanitizeAssign(v1, p1, v2, p2, l) :-
    TaintSanitizeAllEdge(v1, p1, v2, p2), TaintSourceVertexNonRec(l, _, _), EnableForwardSlice();
    TaintSanitizeAllEdge(v1, p1, v2, p2), LeakingSinkVertexNonRec(l, _, _), EnableForwardSlice().
forward_flow.input_.SanitizeVertex(v, p, l) :-
    TaintSanitizeVertex(l, v, p), EnableForwardSlice().
forward_flow.input_.SanitizeVertex(v, p, l) :-
    TaintSanitizeAllVertex(v, p), TaintSourceVertexNonRec(l, _, _), EnableForwardSlice();
    TaintSanitizeAllVertex(v, p), LeakingSinkVertexNonRec(l, _, _), EnableForwardSlice().
backward_flow.input_.SliceBackward() :-
    EnableBackwardSlice().
backward_flow.input_.StartVertex(v, p, label) :-
    LeakingSinkVertex(label, v, p), EnableBackwardSlice().
backward_flow.Vertex(v, p) :-
    Vertex(v, p), EnableBackwardSlice().
backward_flow.VirtualAssign(s, v2, p2, v1, p1, r, ctx) :-
    VirtualAssign(s, v1, p1, v2, p2, r, ctx), EnableBackwardSlice().
backward_flow.input_.SanitizeAssign(v2, p2, v1, p1, l) :-
    TaintSanitizeEdge(l, v1, p1, v2, p2), EnableBackwardSlice().
backward_flow.input_.SanitizeAssign(v2, p2, v1, p1, l) :-
    TaintSanitizeAllEdge(v1, p1, v2, p2), TaintSourceVertexNonRec(l, _, _), EnableBackwardSlice();
    TaintSanitizeAllEdge(v1, p1, v2, p2), LeakingSinkVertexNonRec(l, _, _), EnableBackwardSlice().
backward_flow.input_.SanitizeVertex(v, p, l) :-
    TaintSanitizeVertex(l, v, p), EnableBackwardSlice().
backward_flow.input_.SanitizeVertex(v, p, l) :-
    TaintSanitizeAllVertex(v, p), TaintSourceVertexNonRec(l, _, _), EnableBackwardSlice();
    TaintSanitizeAllVertex(v, p), LeakingSinkVertexNonRec(l, _, _), EnableBackwardSlice().
.decl isTainted(label: SliceLabelType, v: CVar, p: CAccessPath)
isTainted(label, v, p) :-
    forward_flow.isReachable(v, p, label).
CTADLStats("source vertices", n) :-
    n = count : { TaintSourceVertex(agg_w34, agg_w35, agg_w36) }.
CTADLStats("sink vertices", n) :-
    n = count : { LeakingSinkVertex(agg_w37, agg_w38, agg_w39) }.
CTADLStats("tainted-vertex", n) :-
    n = count : { isTainted(agg_w40, agg_w41, agg_w42) }.
TaintSourceVertex(label, v, p) :-
    TaintSpec("source", iv, ip, label, fid, _, _, _), (Global(iv, _), v = cat(fid, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fid, cat("/", iv)), tp = ""), p = cat(tp, ip).
LeakingSinkVertex(label, v, p) :-
    TaintSpec("sink", iv, ip, label, fid, _, _, _), (Global(iv, _), v = cat(fid, cat("/", "<globals>")), tp = cat(".", iv); !Global(iv, _), v = cat(fid, cat("/", iv)), tp = ""), p = cat(tp, ip).
TaintSanitizeEdge(label, v1, p1, v2, p2) :-
    TaintSpec("sanitize", iv1, ip1, label, fid, _, iv2, ip2), (Global(iv1, _), v1 = cat(fid, cat("/", "<globals>")), tp1 = cat(".", iv1); !Global(iv1, _), v1 = cat(fid, cat("/", iv1)), tp1 = ""), p1 = cat(tp1, ip1), (Global(iv2, _), v2 = cat(fid, cat("/", "<globals>")), tp2 = cat(".", iv2); !Global(iv2, _), v2 = cat(fid, cat("/", iv2)), tp2 = ""), p2 = cat(tp2, ip2).
.decl FlowlogUnit(u: int32)
FlowlogUnit(0).
